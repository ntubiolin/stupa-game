        {EObjective::Talk, TEXT("Report back to the Pharping Village Elder"), TEXT("返回帕平村向長老回報泉眼微湧之事"), 1, TEXT("\"Look! Cool water beads are seeping back into the stone basins, and even our village well feels damp again! You have saved our people from despair.\""), TEXT("「啊！石槽中竟重新滲出清涼的水珠，村裡的古井也有了濕氣！行者，你真是帕平谷地的恩人。」"), TEXT("villageElder"), TEXT("Pharping Village Elder"), TEXT("帕平村長老")},
