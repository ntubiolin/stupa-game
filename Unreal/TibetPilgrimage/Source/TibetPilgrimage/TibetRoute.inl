        {EObjective::Interact, TEXT("Light all 7 butter lamp niches in Yangleshö Cave"), TEXT("點燃揚列雪洞內的七處酥油燈龕（7 盞齊明）"), 7, TEXT(""), TEXT("")},
        {EObjective::Talk, TEXT("Speak with the Pure Vision of Guru Rinpoche"), TEXT("與洞中顯現的蓮花生大士淨相交談"), 1, TEXT("\"Well done, faithful practitioner. The seven lamps of wisdom illuminate Yangleshö Cave and reveal the cloud of ignorance shrouding this valley.\""), TEXT("「善哉，具信的行者。七盞智慧明燈照亮了揚列雪洞，也照見了籠罩此谷的無明障雲。」"), TEXT("guruVision.pharping"), TEXT("Guru Rinpoche (Pure Vision)"), TEXT("蓮花生大士（淨相）")},
        {EObjective::Talk, TEXT("Meet the Indian Messenger at the Western Canyon entrance"), TEXT("在西側峽谷入口與背負經函的印度行者會合"), 1, TEXT("\"Thank goodness you are here! I traveled day and night from India carrying the Vajrakīlaya scriptures on my back, but swirling sandstorms and spirits have trapped me in this canyon.\""), TEXT("「呼……謝天謝地！我自印度一路兼程，背上負著蓮師囑託的《普巴金剛續》梵夾，但這峽谷裡狂沙蔽日、障魔四起，我實在寸步難行。」"), TEXT("messenger"), TEXT("Indian Messenger"), TEXT("印度行者")},
        {EObjective::Escort, TEXT("Escort the Indian Messenger through the canyon to Yangleshö Cave"), TEXT("護送印度行者沿峽谷古道抵達揚列雪洞"), 1, TEXT(""), TEXT(""), TEXT("messenger")},
        {EObjective::Talk, TEXT("Deliver the Vajrakīlaya scriptures to Guru Rinpoche"), TEXT("向蓮花生大士淨相呈遞《普巴金剛續》經函"), 1, TEXT("\"Now that the Vajrakīlaya scriptures have arrived, all auspicious conditions are complete. Know that the three-bladed Phurba is no weapon of harm — it pierces directly through the three poisons of clinging, anger, and delusion.\""), TEXT("「《普巴金剛》法要既至，緣起已然具足。所謂『普巴』（普巴橛），三棱鋒刃並非外傷眾生之兵器，而是直刺貪、嗔、癡三毒根本的慈悲智慧。」"), TEXT("guruVision.pharping"), TEXT("Guru Rinpoche (Pure Vision)"), TEXT("蓮花生大士（淨相）")},
        {EObjective::Reach, TEXT("Ascend to Asura Cave on the northern cliff"), TEXT("登上北側懸崖的阿蘇拉洞壇城"), 1, TEXT(""), TEXT("")},
        {EObjective::Boss, TEXT("Subdue the Drought Lord at Asura Cave"), TEXT("調伏盤踞阿蘇拉洞的旱障魔主"), 1, TEXT(""), TEXT("")},
        {EObjective::Talk, TEXT("Return to Yangleshö Cave to receive Guru Rinpoche's teaching"), TEXT("返回揚列雪洞領受蓮花生大士的普巴金剛教授"), 1, TEXT("\"Marvelous! Look how gentle rain pours over Pharping Valley — parched earth turns emerald green and the three springs brim with living water.\""), TEXT("「善哉！你看帕平谷地甘霖普降，焦土化為青疇，三處泉眼再度湧流不息。」"), TEXT("guruVision.pharping"), TEXT("Guru Rinpoche (Pure Vision)"), TEXT("蓮花生大士（淨相）")},
