        {EObjective::Talk, TEXT("Speak with \"Guru Vision · Gateway to Tibet\" beside the Pass Latse"), TEXT("在山口拉則旁與「蓮師淨相・入藏法影」交談"), 1, TEXT("Beside the monumental stones of the Pass Latse, golden lotus light coalesces into the majestic form of Guru Padmasambhava. Holding a vajra scepter and a resonant ghanta bell, his gaze sweeps beyond the snow peaks toward the vast Tibetan plateau."), TEXT("在芒域山口的拉則巨石旁，金色蓮華光影凝聚成蓮花生大士威嚴的法相。大士手執金剛杵與清脆的嘎嗚金剛鈴，目光越過連綿雪峰，望向廣袤的吐蕃高原。"), TEXT("guruVision.mangyul"), TEXT("Guru Vision · Gateway to Tibet"), TEXT("蓮師淨相・入藏法影")},
        {EObjective::Interact, TEXT("Hang a string of five-colored prayer flags at the Pass Latse (Press E)"), TEXT("在山口拉則掛起一串五色經幡（按 E）"), 1, TEXT(""), TEXT("")},
    }},
    {TEXT("yarlung"), {
