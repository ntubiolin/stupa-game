        {EObjective::Kora, TEXT("Walk 1 clockwise kora around Samye Monastery’s outer perimeter wall"), TEXT("順時針繞行桑耶寺圓形外垣一圈（轉經一匝）"), 9, TEXT(""), TEXT("")},
