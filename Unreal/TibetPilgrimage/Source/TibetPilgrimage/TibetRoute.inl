    {TEXT("mangyul"), {
        {EObjective::Talk, TEXT("Speak with Tibetan Envoy Ba Salnang at the Envoy Camp"), TEXT("與使者營地的吐蕃迎請使巴・賽囊交談"), 1, TEXT("\"Homage to you, traveler! I am Ba Salnang, royal envoy of Tibetan Emperor Trisong Detsen. By decree of the Tsenpo, we have come to Mangyul · Kyirong Pass to welcome the Great Master of Oddiyana, Padmasambhava, into Tibet!\""), TEXT("「頂禮遠道而來的行者！吾乃吐蕃贊普赤松德贊座下迎請使巴・賽囊。我們奉贊普聖旨，特來芒域・吉隆山口迎請鄔金大士蓮花生入藏！」"), TEXT("envoyLeader"), TEXT("Tibetan Envoy · Ba Salnang"), TEXT("吐蕃迎請使・巴・賽囊")},
        {EObjective::Interact, TEXT("Pass the trials and place Oath Stones at all 12 Tenma Altars"), TEXT("通過試煉並在十二座丹瑪祭壇安放誓言石"), 12, TEXT(""), TEXT("")},
        {EObjective::Reach, TEXT("Ascend to the Pass Latse arena at the summit of Mangyul Pass"), TEXT("登上芒域山口頂端的拉則廣場"), 1, TEXT(""), TEXT("")},
