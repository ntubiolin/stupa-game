        {EObjective::Interact, TEXT("Align the 4 crystal pillars to open the Terma Casket and collect the Terma Scroll Shard"), TEXT("解開四柱日光折射機關，自伏藏匣取得「協扎伏藏經卷殘片」"), 4, TEXT(""), TEXT("")},
        {EObjective::Combat, TEXT("Calm 15 rampaging wild yaks in the valley"), TEXT("安撫並平息河谷中狂暴失控的野犛牛（15 頭）"), 15, TEXT(""), TEXT("")},
        {EObjective::Talk, TEXT("Speak with Herder Dawa in Yarlung Village"), TEXT("前往雅隆村與牧人達瓦交談，詢問雅拉香波山神震怒之因"), 1, TEXT("\"Wonderful! Look how the white glare fades from their eyes as they lower their heads to graze the grass again! They are ordinary animals, not demons—your compassionate mantra restored their peace.\""), TEXT("「太好了！你看那些野犛牛眼中的白芒退去，又乖乖低頭吃草了！牠們並非妖魔，只是被山神的暴風雪嚇壞的畜生道生靈，多虧你以慈悲心安撫了牠們。」"), TEXT("herder"), TEXT("Yarlung Herder Dawa"), TEXT("雅隆牧人達瓦")},
        {EObjective::Reach, TEXT("Reach the northern Alpine Pasture facing Mount Yarlha Shampo"), TEXT("前往北側高山牧場，直面雅拉香波雪山"), 1, TEXT(""), TEXT("")},
        {EObjective::Boss, TEXT("Subdue the Yarlha Shampo White Yak"), TEXT("調伏化現為巨型白犛牛的雅拉香波山神"), 1, TEXT(""), TEXT("")},
        {EObjective::Talk, TEXT("Speak with the Pure Vision of Guru Rinpoche to receive the Lotus Shield teaching"), TEXT("與高山牧場南緣的蓮花生大士淨相交談，領受「蓮華護盾」教授"), 1, TEXT("\"Well done! Even proud Yarlha Shampo, the Great White Yak of Yarlung, has bowed before the Vajra Hook & Lasso, assuming the form of a white-robed youth to offer his life-vein and guard the Dharma.\""), TEXT("「善哉，行者！連吐蕃最尊貴傲慢的雅拉香波白犛牛，亦已在金剛鉤索與空性悲心前折服，化為白衣童子獻出心命、立誓護持佛法。」"), TEXT("guruVision.yarlung"), TEXT("Guru Rinpoche (Pure Vision)"), TEXT("蓮花生大士（淨相）")},
    }},
    {TEXT("samye"), {
        {EObjective::Talk, TEXT("Speak with Abbot Śāntarakṣita at the construction camp"), TEXT("在桑耶營地與寂護大師交談"), 1, TEXT("Welcome, pilgrim. I am Śāntarakṣita of Nālandā, invited by Trisong Detsen to lay the foundation of Samye on the north bank of the Yarlung Tsangpo."), TEXT("遠道而來的行者，善來此間。老衲寂護（Śāntarakṣita），應贊普赤松德贊之請自那爛陀北來，欲於此雅魯藏布江北岸建立三寶常住之桑耶寺。"), TEXT("shantarakshita"), TEXT("Śāntarakṣita"), TEXT("寂護大師")},
